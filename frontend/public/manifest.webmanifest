{
  "name": "Factura — Control de gastos",
  "short_name": "Factura",
  "description": "Facturas, pagos y gastos diarios con avisos de vencimiento.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0B1020",
  "theme_color": "#0B1020",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Nuevo gasto", "url": "/gastos?nuevo=gasto", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Escanear factura", "url": "/facturas?escanear=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", "image/*", "application/xml", "text/xml", ".pdf", ".jpg", ".jpeg", ".png", ".webp", ".xml"]
        }
      ]
    }
  }
}
