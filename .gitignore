# ==========================================================================
# Secretos y configuración local (NUNCA subir)
# ==========================================================================
# .env tiene POSTGRES_PASSWORD, SECRET_KEY, el token de Telegram, el secreto de
# Google y la contraseña de correo. Solo se sube la plantilla .env.example.
.env
.env.*
!.env.example
*.local
docker-compose.override.yml
compose.override.yml

# Certificados y claves (HTTPS, Tailscale, firmas, credenciales de Google)
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
certs/
secrets/
client_secret*.json
credentials*.json
service-account*.json
# Informes de auditoría de seguridad: describen vulnerabilidades abiertas.
SECURITY-AUDIT-*.md

# ==========================================================================
# Datos reales: respaldos, archivos subidos y exportaciones
# ==========================================================================
# ./backups tiene copias completas de la base y de las facturas.
backups/
uploads/
*.dump
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.tgz
*.tar.gz
*.zip
*.7z
*.rar

# Facturas, extractos, reportes y capturas de pantalla sueltos
