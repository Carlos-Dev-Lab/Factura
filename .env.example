# Copiá este archivo como .env y completá los valores.

# Contraseña de la base de datos (inventá una larga).
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Clave para firmar las sesiones. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres

# Puerto donde se abre la aplicación: http://localhost:8080
APP_PORT=8080

# Poné true SOLO si accedés por HTTPS (por ejemplo con Tailscale o detrás de un proxy con certificado).
COOKIE_SECURE=false

# Dirección pública con HTTPS (por ejemplo https://factura.tu-red.ts.net). Se usa en los enlaces
# de las notificaciones. Las notificaciones push del celular necesitan HTTPS.
PUBLIC_URL=

# Opcional, recomendado cuando ya uses HTTPS: nombres con los que se entra a la app, separados por
# coma (por ejemplo mi-pc.tu-red.ts.net,localhost). Vacío = cualquiera. Con valor, se rechaza todo
# pedido que llegue con otro nombre (protege contra páginas que intentan hablarle a tu servidor).
# Si también entrás por la IP de la PC en tu Wi-Fi, agregala (por ejemplo 192.168.0.10).
ALLOWED_HOSTS=

# Opcional: avisos por Telegram. Creá un bot con @BotFather y pegá aquí su token.
# Después, en Ajustes → Avisos, tocá "Vincular Telegram".
TELEGRAM_BOT_TOKEN=

# Opcional: ingreso con Google. Creá un cliente OAuth "Aplicación web" en
# https://console.cloud.google.com/apis/credentials con este URI de redireccionamiento autorizado:
#   http://localhost:8080/api/v1/auth/google/callback
# y, si usás HTTPS, también el de tu dirección pública (PUBLIC_URL + /api/v1/auth/google/callback).
# Vacíos = no aparece el botón "Continuar con Google". Ver README → Ingreso con Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: avisos por email. Una cuenta del servidor manda los correos a cada usuario.
# Con Gmail: activá la verificación en 2 pasos y creá una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (16 letras; NO uses tu contraseña normal).
# Vacíos = el canal de email queda desactivado.
SMTP_USER=
SMTP_PASSWORD=
# Servidor y puerto (Gmail por defecto). Remitente opcional, por ejemplo: Factura <tu-cuenta@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=

# Respaldo automático diario (hora local y días que se guardan).
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Carpeta del servidor donde se guardan los respaldos. Vacío = ./backups dentro del proyecto.
# Puede estar en otro disco, por ejemplo D:/Respaldos/factura (Windows) o /mnt/respaldos/factura (Linux).
BACKUP_DIR=

# El primer usuario siempre puede registrarse. Poné true para permitir más cuentas.
ALLOW_REGISTRATION=false

# Duración de la sesión en minutos (720 = 12 horas).
ACCESS_TOKEN_MINUTES=720

TZ=America/Asuncion

# Rango de direcciones de la red interna de Docker. Cambialo solo si choca con tu Wi-Fi o tu VPN
# (en Windows se ven con ipconfig; en Linux con ip addr). Vacío = 10.213.47.0/27.
DOCKER_SUBNET=
